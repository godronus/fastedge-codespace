#!/bin/bash
# Signs the FastEdge MCP server in to Gcore without copying a long command.
#   fastedge-login --save <key>   the AI agent saves the server's --seal-to key
#   fastedge-login                you run this in a terminal and paste the connect code
# Only a validated key is saved, never a command, so this can only ever run the login.
set -euo pipefail

KEY_FILE=/tmp/fastedge-login/seal-key
IMAGE=ghcr.io/g-core/fastedge-mcp-server:latest

KEY_DIR="$(dirname "$KEY_FILE")"

valid_key() { [[ "$1" =~ ^[A-Za-z0-9_-]{43}$ ]]; }
# /tmp is shared: only trust a real directory that we own and nobody else can write to
safe_dir() {
  [ -d "$KEY_DIR" ] && [ ! -L "$KEY_DIR" ] && [ -O "$KEY_DIR" ] && [ "$(stat -c %a "$KEY_DIR")" = 700 ] ||
    { echo "fastedge-login: $KEY_DIR is not a private directory owned by you; remove it and try again" >&2; exit 2; }
}

if [ "${1:-}" = "--save" ]; then
  valid_key "${2:-}" || { echo "fastedge-login: --save needs the 43-character --seal-to key" >&2; exit 2; }
  mkdir -m 700 "$KEY_DIR" 2>/dev/null || true
  safe_dir
  printf '%s\n' "$2" > "$KEY_FILE"
  echo "Saved. Ask the user to open a new terminal and run: fastedge-login"
  exit 0
fi

[ -t 0 ] || { echo "fastedge-login: run this yourself in a terminal; it asks for the connect code" >&2; exit 2; }
[ ! -e "$KEY_DIR" ] || safe_dir
key="$(cat "$KEY_FILE" 2>/dev/null || true)"
valid_key "$key" || { echo "No sign-in request yet. Ask your AI agent to do something with your Gcore account first." >&2; exit 1; }

case "${GCORE_API_BASE:-https://api.gcore.com}" in
  https://api.gcore.com*) portal=https://portal.gcore.com ;;
  https://api.preprod.world*) portal=https://portal.preprod.world ;;
  *) portal="" ;;
esac
link="${portal:+$portal/fastedge/agent-connect?ephemeral=1}"
echo "1. Open ${link:-the sign-in link from your agent} in your browser,"
echo "   choose the manual option and approve."
echo "2. Paste the connect code at the prompt below. Never paste it into the chat."
echo ""

args=(run --rm -it -v fastedge-session:/run/fastedge -e FASTEDGE_SESSION=ephemeral)
[ -z "${GCORE_API_BASE:-}" ] || args+=(-e "GCORE_API_BASE=$GCORE_API_BASE")
# The key belongs to one MCP server start; drop it once used so a stale one isn't reused
docker "${args[@]}" "$IMAGE" login --code --seal-to "$key" && rm -f "$KEY_FILE"
